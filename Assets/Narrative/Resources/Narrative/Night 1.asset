      completionId: 
      text: 
      number: 0
      value: 0
      circuit: {fileID: 0}
      audio: {fileID: 0}
      sequence: {fileID: 0}
    - kind: 0
      target: Supervisor
      completionId: intro.supervisor
      text: "Hi, it's the building supervisor. Sorry for the late start. Aoba Apartments
        is at the end of the lane. \xA524,000 per night, as agreed."
      number: 0
      value: 0
      circuit: {fileID: 0}
      audio: {fileID: 0}
      sequence: {fileID: 0}
    exit: []
  - id: begin
    title: Start the night shift
    objective: Start the night shift
    guidance: Take the Security Office key from the utility-room workbench, unlock
      the office, and sign in on the small desk pad or phone Tasks page.
    supervisorMessage: Log in when you get to the desk. Don't worry about the old
      guard's things. Just leave them where they are.
    protagonistDialogue: 
