MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4f4d3c9536362f04d9111f257588a5ad, type: 3}
  m_Name: Night 1
  m_EditorClassIdentifier: 
  nightNumber: 1
  title: The New Hire
  protagonist: Aki
  date: 2026-11-01
  startSeconds: 78600
  startingBattery: 100
  openingLines:
  - Two months behind on rent.
  - I've lost count of how many jobs I've applied for.
  - Then, yesterday, someone finally called back.
  - An overnight security position at an old apartment building.
  - The pay was surprisingly good.
  - They didn't even ask for an interview.
  - I guess I can't afford to be picky.
  openingLineSeconds: 3.1
  fadeSeconds: 1.4
  history:
  - contact: Landlord
    time: 2026-10-30 18:11
    body: Your rent is now two months overdue. I need to know when you can pay.
    id: rent.1
    outgoing: 0
    read: 1
  - contact: Landlord
    time: 2026-10-30 18:16
    body: I'm sorry. I'm still waiting to hear back from a few jobs.
    id: rent.2
    outgoing: 1
    read: 1
  - contact: Landlord
    time: 2026-11-01 17:46
    body: I can't keep putting this off. Please give me a payment date by Friday.
    id: rent.3
    outgoing: 0
    read: 1
  - contact: Landlord
    time: 2026-11-01 17:49
    body: I found a night job. It starts tonight. I'll send something as soon as
      I get paid.
    id: rent.4
    outgoing: 1
    read: 1
  approachSignal: approach.apartment
  approachMessages:
  - contact: Supervisor
    time: 
    body: The office is just inside, on the left. The key's on the little workbench
      in the utility room next door.
    id: approach.office
    outgoing: 0
    read: 0
  - contact: Supervisor
    time: 
    body: Our last guard stopped showing up a few days ago. I tried his number a
      few times. Nothing. Thought he'd just quit, to be honest.
    id: approach.guard
    outgoing: 0
    read: 0
  - contact: Supervisor
    time: 
    body: His jacket and things are still in there. Leave those for now. I'll try
      him again tomorrow.
    id: approach.belongings
    outgoing: 0
    read: 0
  management: {fileID: 11400000, guid: e15e562723cc9f2479005f5dfcef3ca8, type: 2}
  shiftLabel: Overnight security
  staffPortalName: Aoba Property Management
  managementNoticeTitle: Shift handover
  managementNotice: Keep shared passageways clear. Record unresolved faults before
    signing out and return borrowed keys to the office.
  beats:
  - id: arrival
    title: Get to Aoba Apartments
    objective: Get to Aoba Apartments
    guidance: Follow the alley to the apartment entrance. Press Tab to check the
      supervisor's message.
    supervisorMessage: 
    protagonistDialogue: 
    nextStepId: begin
    conditions:
    - kind: 1
      target: Apartment
      value: 
      checkCurrentStateOnEnter: 0
    checkpointOnBegin: 1
    checkpointOnComplete: 1
    scriptedSequence: {fileID: 0}
