    status: 0
  requests:
  - reference: M-0241
    time: 20:35
    location: 4F corridor
    title: Corridor light reported faulty
    status: Reported
    description: Ceiling fixture intermittently fails to start.
  - reference: M-0242
    time: 20:50
    location: 1F entrance camera
